package pages

import (
	"fmt"
	"github.com/timeitel/groceries/internal/types"
	c "github.com/timeitel/groceries/internal/web/views/components"
	"github.com/timeitel/groceries/internal/web/views/layouts"
)

templ AdminHome(products types.Products) {
	@layouts.Admin() {
		@c.AddProductForm()
		<hr class="-mx-5 mb-6 border border-black"/>
		<div id="products" class="flex flex-wrap gap-4">
			for _, p := range products {
				<a href={ templ.URL(fmt.Sprintf("/admin/products/%d", p.ID)) }>
					@c.ProductCard(p)
				</a>
			}
		</div>
	}
}
