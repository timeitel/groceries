package components

import "github.com/timeitel/groceries/internal/domain/cart"

templ CartItemCard(i cart.Item) {
	<div class="w-48 bg-gray-100 rounded border border-white shadow-sm">
		<div class="py-2 px-4 border-b border-white">
			<strong>{ i.Name }</strong>
		</div>
		<div class="py-2 px-4">{ string(i.Quantity) }</div>
	</div>
}
